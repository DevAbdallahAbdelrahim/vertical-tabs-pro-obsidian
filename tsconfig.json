{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2021",
    "allowJs": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "moduleResolution": "node",
    "defaultLibCheck": false,
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2021"]
  },
  "include": ["src/**/*"]
}
